# All settings are optional; defaults are shown.
CERT_DATABASE_URL=sqlite:///./data/certgen.db
CERT_STORAGE_DIR=./data/certificates
CERT_MAX_RECIPIENTS=1000
CERT_WORKER_MODE=thread      # thread | inline | manual
CERT_MAX_WORKERS=2
# CERT_FONT_PATH=/path/to/NotoSans-Regular.ttf   # enables non-Latin names
